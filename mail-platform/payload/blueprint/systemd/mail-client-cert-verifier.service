[Unit]
ConditionPathExists=/etc/mail-client-certificates-v1/private-backends-approved.json
Description=Mail device certificates verifier
Requires=mariadb.service
After=mariadb.service
[Service]
Type=notify
NotifyAccess=main
User=mailcert-verifier
Group=mailcert-owner
ExecStart=/usr/bin/python3 -I -S -B /usr/local/lib/mail-client-certificates-v1/client-certificates/runtime-completion-v1/start.py verifier --config /etc/mail-client-certificates-v1/verifier.json
RuntimeDirectory=mail-client-certificates-v1/verifier
RuntimeDirectoryMode=0750
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
KeyringMode=private
MemorySwapMax=0
MemoryMax=512M
LimitMEMLOCK=256M
LimitCORE=0
TasksMax=128
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=20
KillMode=mixed
StandardOutput=journal
StandardError=journal
LoadCredential=webauthn_verifier:/var/lib/mail-client-certificates-v1/credentials/verifier/webauthn_verifier
