[Unit]
Description=Mail administration observations and public DNS
After=mail-feature-config-v1.service

[Service]
Type=oneshot
User=root
Group=mailadmin
SupplementaryGroups=root
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/mail-feature-runtime-v1/launch_observer.py
RuntimeDirectory=mail-feature-health-v1
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
PrivateNetwork=no
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
InaccessiblePaths=/var/vmail /var/mail /var/spool/postfix /etc/dovecot /etc/letsencrypt /run/mysqld /var/lib/mysql /etc/mail-feature-admin-v1
ReadWritePaths=/var/lib/mail-feature-runtime-v1 /run/mail-feature-health-v1
CPUQuota=50%
MemoryMax=256M
MemorySwapMax=0
TasksMax=80
UMask=0077
TimeoutStartSec=150
TimeoutStopSec=15
LimitCORE=0
