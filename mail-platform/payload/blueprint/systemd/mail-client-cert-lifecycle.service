[Unit]
ConditionPathExists=/etc/mail-client-certificates-v1/private-backends-approved.json
Description=Mail device certificates lifecycle
Requires=mariadb.service
After=mariadb.service
[Service]
Type=notify
NotifyAccess=main
User=mailcert-lifecycle
Group=mailcert-owner
ExecStart=/usr/bin/python3 -I -S -B /usr/local/lib/mail-client-certificates-v1/client-certificates/runtime-completion-v1/start.py lifecycle --config /etc/mail-client-certificates-v1/lifecycle.json
RuntimeDirectory=mail-client-certificates-v1/lifecycle
RuntimeDirectoryMode=0750
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
KeyringMode=private
MemorySwapMax=0
MemoryMax=512M
LimitMEMLOCK=256M
LimitCORE=0
TasksMax=128
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=20
KillMode=mixed
StandardOutput=journal
StandardError=journal
LoadCredential=lifecycle_provisioner:/var/lib/mail-client-certificates-v1/credentials/lifecycle/lifecycle_provisioner
