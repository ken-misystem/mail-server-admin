[Unit]
ConditionPathExists=/etc/mail-client-certificates-v1/activation-approved.json
Description=Mail device certificates gate
Requires=mariadb.service
After=mariadb.service
Requires=mail-client-cert-issuer.service mail-client-cert-network.service mail-client-cert-postfix-backend.service mail-client-cert-dovecot-backend.service mail-client-cert-coordination.service
After=mail-client-cert-issuer.service mail-client-cert-network.service mail-client-cert-postfix-backend.service mail-client-cert-dovecot-backend.service mail-client-cert-coordination.service
JoinsNamespaceOf=mail-client-cert-network.service
Requires=mail-client-cert-gate.socket
[Service]
Type=notify
NotifyAccess=main
User=mailcert-gate
Group=mailcert-gate
ExecStart=/usr/bin/python3 -I -S -B /usr/local/lib/mail-client-certificates-v1/client-certificates/runtime-completion-v1/start.py gate --config /etc/mail-client-certificates-v1/gate.json
RuntimeDirectory=mail-client-certificates-v1/gate
RuntimeDirectoryMode=0750
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
KeyringMode=private
MemorySwapMax=0
MemoryMax=512M
LimitMEMLOCK=256M
LimitCORE=0
TasksMax=128
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=20
KillMode=mixed
StandardOutput=journal
StandardError=journal
SupplementaryGroups=mailcert-owner
OpenFile=/proc/1/ns/net:host-net:read-only
LoadCredential=gateway_reader:/var/lib/mail-client-certificates-v1/credentials/gate/gateway_reader
LoadCredential=server_certificate:/var/lib/mail-client-cert-public-v1/tls/current/certificate.pem
LoadCredential=server_key:/var/lib/mail-client-cert-public-v1/tls/current/key.pem
