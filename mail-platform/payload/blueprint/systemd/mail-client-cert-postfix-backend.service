[Unit]
ConditionPathExists=/etc/mail-client-certificates-v1/private-backends-approved.json
Description=Private certificate Postfix smtpd
Requires=mail-client-cert-milter.service
After=mail-client-cert-milter.service
Requires=mail-client-cert-network.service mail-client-cert-coordination.service
After=mail-client-cert-network.service mail-client-cert-coordination.service
JoinsNamespaceOf=mail-client-cert-network.service
[Service]
Type=notify
User=postfix
Group=postfix
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RuntimeDirectory=mail-client-certificates-v1/postfix
RuntimeDirectoryMode=0755
ExecStartPre=+/usr/bin/python3 -I -S -B /usr/local/lib/mail-client-cert-activation-v1/runtime_init.py
ExecStartPre=+/usr/bin/python3 -I -S -B /usr/local/lib/mail-client-certificates-v1/client-certificates/runtime-completion-v1/coordination.py --snapshot
ExecStart=/usr/bin/python3 -I -S -B /usr/local/lib/mail-client-certificates-v1/client-certificates/runtime-completion-v1/native_smtpd.py
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
KeyringMode=private
MemorySwapMax=0
MemoryMax=512M
LimitMEMLOCK=256M
LimitCORE=0
TasksMax=128
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=20
KillMode=mixed
StandardOutput=journal
StandardError=journal
BindReadOnlyPaths=/var/spool/postfix/public/cleanup:/run/mail-client-certificates-v1/postfix/public/cleanup
BindReadOnlyPaths=/var/spool/postfix/private/rewrite:/run/mail-client-certificates-v1/postfix/private/rewrite
BindReadOnlyPaths=/var/spool/postfix/private/auth:/run/mail-client-certificates-v1/postfix/private/auth
BindReadOnlyPaths=/var/spool/postfix/private/proxymap:/run/mail-client-certificates-v1/postfix/private/proxymap
BindReadOnlyPaths=/var/spool/postfix/private/anvil:/run/mail-client-certificates-v1/postfix/private/anvil
BindReadOnlyPaths=/run/mail-client-certificates-v1/milter/milter.sock:/run/mail-client-certificates-v1/native/milter.sock
ReadWritePaths=/run/mail-client-certificates-v1/coordination
