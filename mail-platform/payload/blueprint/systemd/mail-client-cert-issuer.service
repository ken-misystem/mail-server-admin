[Unit]
ConditionPathExists=/etc/mail-client-certificates-v1/private-backends-approved.json
Description=Mail device certificates issuer
Requires=mariadb.service
After=mariadb.service
[Service]
Type=notify
NotifyAccess=main
User=mailcert-issuer
Group=mailcert-owner
ExecStart=/usr/bin/python3 -I -S -B /usr/local/lib/mail-client-certificates-v1/client-certificates/runtime-completion-v1/start.py issuer --config /etc/mail-client-certificates-v1/issuer.json
RuntimeDirectory=mail-client-certificates-v1/issuer
RuntimeDirectoryMode=0750
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
KeyringMode=private
MemorySwapMax=0
MemoryMax=512M
LimitMEMLOCK=256M
LimitCORE=0
TasksMax=128
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=20
KillMode=mixed
StandardOutput=journal
StandardError=journal
SupplementaryGroups=mailcert-gate
StateDirectory=mail-client-cert-issuer-v1
StateDirectoryMode=0700
LoadCredential=issuer_journal:/var/lib/mail-client-certificates-v1/credentials/issuer/issuer_journal
LoadCredential=issuer_certificate:/var/lib/mail-client-certificates-v1/credentials/issuer/issuer_certificate
LoadCredential=issuer_key:/var/lib/mail-client-certificates-v1/credentials/issuer/issuer_key
LoadCredential=issuer_password:/var/lib/mail-client-certificates-v1/credentials/issuer/issuer_password
