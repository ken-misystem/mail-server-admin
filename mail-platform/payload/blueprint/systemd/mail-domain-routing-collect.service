[Unit]
Description=Collect domain MX delivery decisions (candidate)
After=network-online.target mariadb.service

[Service]
Type=oneshot
User=mail-route-collector
Group=mail-route-collector
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/mail-domain-routing-v1/launch_collector.py
StateDirectory=mail-domain-routing-v1
StateDirectoryMode=0755
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes
UMask=0077
LimitCORE=0
MemoryMax=128M
CPUQuota=15%
TasksMax=8
TimeoutStartSec=55
PrivateMounts=yes
BindReadOnlyPaths=/etc/mail-domain-routing-v1/public-resolv.conf:/etc/resolv.conf
