[Unit]
ConditionPathExists=/etc/mail-client-certificates-v1/activation-approved.json
Description=Mail device certificates owner
Requires=mariadb.service
After=mariadb.service
Requires=mail-client-cert-lifecycle.service mail-client-cert-verifier.service mail-client-cert-issuer.service mail-client-cert-gate.service
After=mail-client-cert-lifecycle.service mail-client-cert-verifier.service mail-client-cert-issuer.service mail-client-cert-gate.service
[Service]
Type=notify
NotifyAccess=main
User=mailcert-owner
Group=www-data
ExecStart=/usr/bin/python3 -I -S -B /usr/local/lib/mail-client-certificates-v1/client-certificates/runtime-completion-v1/start.py owner --config /etc/mail-client-certificates-v1/owner.json
RuntimeDirectory=mail-client-certificates-v1/owner
RuntimeDirectoryMode=0750
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
KeyringMode=private
MemorySwapMax=0
MemoryMax=512M
LimitMEMLOCK=256M
LimitCORE=0
TasksMax=128
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=20
KillMode=mixed
StandardOutput=journal
StandardError=journal
SupplementaryGroups=mailcert-owner
LoadCredential=identity_reader:/var/lib/mail-client-certificates-v1/credentials/owner/identity_reader
LoadCredential=orchestrator:/var/lib/mail-client-certificates-v1/credentials/owner/orchestrator
LoadCredential=gateway_reader:/var/lib/mail-client-certificates-v1/credentials/owner/gateway_reader
LoadCredential=session_reader:/var/lib/mail-client-certificates-v1/credentials/owner/session_reader
