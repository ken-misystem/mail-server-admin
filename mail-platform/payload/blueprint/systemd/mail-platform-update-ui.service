[Unit]
Description=Mail platform constrained update UI broker
Requires=mail-platform-update-ui.socket
After=mail-platform-update-ui.socket
[Service]
Type=simple
User=root
Group=root
SupplementaryGroups=mailadmin
UMask=0077
ExecStart=/usr/bin/python3 -I -S -B /usr/local/lib/mail-platform-update/broker_entry.py
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mail-platform-update -/etc/mail-management-alerts-v1
InaccessiblePaths=-/etc/mail-management-alerts-v1/discord-webhook.url
RestrictAddressFamilies=AF_UNIX
CPUQuota=10%
MemoryMax=64M
