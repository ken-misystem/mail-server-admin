[Unit]
Description=Bounded incremental mail log index publisher
After=systemd-journald.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/mail-management-log-viewer-v1/runner.py --collect
TimeoutStartSec=60s
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=128M
TasksMax=12
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mail-management-log-viewer-v1
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH CAP_FOWNER
LockPersonality=true

